# Instance configuration for .llm-wiki/lint_wiki.py — belongs to the instance.
# Format: plain YAML (key: value, key: [a, b], one level of indentation for mappings).

# Allowed page types (`type:` in the frontmatter)
page_types: [area, person, project, product, decision, concept, source-summary, draft, meta, template]

# Review interval in days per type: review_by = last_updated + interval
review_days:
  person: 60
  project: 45
  area: 45
  product: 90
  concept: 180
  decision: 180
  meta: 30
  draft: 30
  source-summary: 365
  template: 365

# Additional source prefixes (`<prefix>:<value>`) alongside the core prefixes
source_prefixes: [{{ extra_source_prefixes }}]

# Pages without frontmatter and outside the index
meta_pages: [index.md, log.md]

# Pages that don't need incoming links
orphan_exempt: [backlog.md, overview.md]
